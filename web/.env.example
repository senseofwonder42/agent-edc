# Copier en .env.local (ignoré par git).
# Adresse du serveur Aegra, appelée côté serveur par le proxy Next /api/[..._path].
LANGGRAPH_API_URL=http://localhost:2026

# Transmis en `x-api-key`. Vide tant qu'Aegra tourne avec AUTH_TYPE=noop.
LANGCHAIN_API_KEY=

# Identifiant du graphe : clé de "graphs" dans aegra.json.
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=agent_edc

# Optionnel : laisser vide pour passer par le proxy (le navigateur ne parle pas à Aegra).
NEXT_PUBLIC_LANGGRAPH_API_URL=
