# Copier en .env (ignoré par git). Aucune valeur secrète ici.
# Réglages non sensibles (modèle, génération, raisonnement, agent, journaux) : config.yaml.
# Toute clé de config.yaml reste surchargeable ici, ex. VLM_MODEL=… ou AGENT_PAGE_SIZE=…

# --- E-décès (Oracle, mode thick + wallet) ---
EDC_DSN=
EDC_USER=
EDC_PASSWORD=
EDC_TNS_ADMIN=
EDC_ORACLE_HOME=

# --- Serveur vLLM (API OpenAI-compatible) ---
VLM_BASE_URL=
VLM_API_KEY=EMPTY

# --- Langfuse : instance INTERNE uniquement (§ 10.5) ; activation dans config.yaml ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Tests live uniquement (-m live) ---
LIVE_EDC_ID=
LIVE_EDC_ID_LONG_NOTE=

# --- Serveur Aegra (uv run aegra dev) : PostgreSQL local via docker-compose.yml ---
# 5433 : évite le Postgres de Langfuse (5432). Choisir un mot de passe local ; ou bien DATABASE_URL=postgresql://user:pass@host:5432/base
POSTGRES_USER=agent_edc
POSTGRES_PASSWORD=
POSTGRES_DB=agent_edc
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
AUTH_TYPE=noop
